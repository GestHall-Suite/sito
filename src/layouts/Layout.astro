---
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site.css';

interface Props { title?: string; description?: string; page?: string; noindex?: boolean }
const { title: titleProp, description: descProp, page, noindex = false } = Astro.props;

const siteName = 'GestHall Suite';
const title = page ? `${page} · ${siteName}` : (titleProp ?? `${siteName} — Gestionale per sale giochi VLT e AWP`);
const description = descProp ?? 'Il gestionale per sale giochi con VLT e AWP: cassa per turni, scassettamenti, versamento firmato, report, turni del personale, bar e più sale. Prova gratuita di 14 giorni.';
const canon = new URL(Astro.url.pathname, 'https://gesthallsuite.it').href;
const ogImage = 'https://gesthallsuite.it/og.png';
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b111c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canon} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('gh-site-theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#contenuto" class="sr-only">Vai al contenuto</a>
    <SiteNav />
    <main id="contenuto">
      <slot />
    </main>
    <SiteFooter />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        els.forEach(el => io.observe(el));
      } else els.forEach(el => el.classList.add('in'));
    </script>
  </body>
</html>
