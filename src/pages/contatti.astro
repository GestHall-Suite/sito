---
import Layout from '../layouts/Layout.astro';
import { ICONE } from '../data/aree';
import { piani, PROVA_GIORNI } from '../data/piani';
---
<Layout page="Contatti" description="Richiedi una demo di GestHall Suite, informazioni sui piani o sul programma rivenditori. Risposta entro un giorno lavorativo.">

<section class="page-hero">
  <div class="container">
    <nav class="crumbs" aria-label="Percorso"><a href="/">Home</a><span aria-hidden="true">/</span><span>Contatti</span></nav>
    <span class="eyebrow">Contatti</span>
    <h1>Parliamo della tua sala.</h1>
    <p class="lead">Demo, domande sui piani, migrazione dei dati o programma rivenditori: scrivici e ti rispondiamo entro un giorno lavorativo.</p>
  </div>
</section>

<section class="section-tight" style="padding-top:0" id="modulo">
  <div class="container ct-grid">
    <div class="card ct-form">
      <div class="form-msg ok" id="ct-ok" hidden></div>
      <div class="form-msg err" id="ct-err" hidden></div>
      <form class="form" id="ct" method="post" action="/api/contatto.php" novalidate>
        <div class="field">
          <label for="ct-motivo">Di cosa hai bisogno?</label>
          <select id="ct-motivo" name="motivo">
            <option value="demo">Una demo del gestionale</option>
            <option value="info">Informazioni su piani e prezzi</option>
            <option value="rivenditore">Programma rivenditori</option>
            <option value="assistenza">Assistenza (sono già cliente)</option>
            <option value="altro">Altro</option>
          </select>
        </div>
        <div class="form-row">
          <div class="field"><label for="ct-nome">Nome e cognome</label><input id="ct-nome" name="nome" autocomplete="name" required maxlength="120"></div>
          <div class="field"><label for="ct-email">Email</label><input id="ct-email" name="email" type="email" autocomplete="email" required maxlength="160"></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="ct-tel">Telefono <span>(facoltativo)</span></label><input id="ct-tel" name="telefono" type="tel" autocomplete="tel" maxlength="40"></div>
          <div class="field"><label for="ct-sala">Sala o azienda <span>(facoltativo)</span></label><input id="ct-sala" name="sala" autocomplete="organization" maxlength="160" placeholder="Es. Sala Aurora, Bologna"></div>
        </div>
        <div class="field" id="ct-piano-f">
          <label for="ct-piano">Piano che ti interessa <span>(facoltativo)</span></label>
          <select id="ct-piano" name="piano">
            <option value="">Non lo so ancora</option>
            {piani.map(p => <option value={p.id}>{p.nome}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="ct-msg">Messaggio</label>
          <textarea id="ct-msg" name="messaggio" required maxlength="5000" placeholder="Quante VLT e AWP avete, quanti turni al giorno, cosa usate oggi per la cassa…"></textarea>
        </div>
        <div class="hp" aria-hidden="true"><label for="ct-web">Sito web</label><input id="ct-web" name="sito_web" tabindex="-1" autocomplete="off"></div>
        <input type="hidden" name="t" id="ct-t" value="0">
        <label class="check-line"><input type="checkbox" name="privacy" value="1" required> <span>Ho letto l'<a href="/privacy">informativa privacy</a> e acconsento all'uso dei miei dati per ricevere una risposta.</span></label>
        <button type="submit" class="btn btn-primary btn-lg" id="ct-btn">Invia la richiesta</button>
      </form>
    </div>

    <aside class="ct-side">
      <div class="card">
        <div class="icon" set:html={ICONE.chat}></div>
        <h3>Email</h3>
        <p><a class="link" href="mailto:info@gesthallsuite.it">info@gesthallsuite.it</a></p>
        <p class="small">Risposta entro un giorno lavorativo.</p>
      </div>
      <div class="card">
        <div class="icon" set:html={ICONE.cassa}></div>
        <h3>Come funziona la demo</h3>
        <p>Una videochiamata con una sala configurata come la tua. Poi, se vuoi, installiamo GestHall Suite sul tuo spazio web per {PROVA_GIORNI} giorni di prova senza carta di credito.</p>
      </div>
      <div class="card">
        <div class="icon" set:html={ICONE.utenti}></div>
        <h3>Sei già cliente?</h3>
        <p>Accedi dall'indirizzo della tua sala. Per il piano e la licenza usa l'<a class="ilink" href="/cliente/">area clienti</a>; la <a class="ilink" href="/docs/guida/">guida all'uso</a> risponde alle domande più comuni.</p>
      </div>
    </aside>
  </div>
</section>
</Layout>

<style>
.ct-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 24px; align-items: start }
.ct-form { padding: clamp(22px, 4vw, 36px) }
.ct-form .form-msg { margin-bottom: 18px }
.ct-side { display: grid; gap: 16px }
.ct-side .card { padding: 22px }
.ct-side .icon { width: 38px; height: 38px; margin-bottom: 12px }
.ct-side h3 { font-size: 17px }
.ct-side p + p { margin-top: 6px }
#ct-btn { justify-self: start }
@media (max-width: 900px) { .ct-grid { grid-template-columns: 1fr } }
@media (max-width: 640px) { #ct-btn { justify-self: stretch } }
</style>

<script>
  const f = document.getElementById('ct') as HTMLFormElement;
  const ok = document.getElementById('ct-ok')!;
  const err = document.getElementById('ct-err')!;
  const btn = document.getElementById('ct-btn') as HTMLButtonElement;
  const q = new URLSearchParams(location.search);
  const sel = f.elements.namedItem('motivo') as HTMLSelectElement;
  const piano = f.elements.namedItem('piano') as HTMLSelectElement;
  if (q.get('motivo') && [...sel.options].some(o => o.value === q.get('motivo'))) sel.value = q.get('motivo')!;
  if (q.get('piano')) piano.value = q.get('piano')!;
  const sync = () => { document.getElementById('ct-piano-f')!.hidden = !['demo', 'info'].includes(sel.value); };
  sel.addEventListener('change', sync); sync();
  (document.getElementById('ct-t') as HTMLInputElement).value = String(Date.now());
  const show = (el: HTMLElement, msg: string) => { ok.hidden = err.hidden = true; el.textContent = msg; el.hidden = false; el.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); };
  if (q.get('inviato')) { show(ok, 'Messaggio inviato. Ti rispondiamo entro un giorno lavorativo.'); f.hidden = true; }
  if (q.get('errore')) show(err, q.get('errore')!);

  f.addEventListener('submit', async e => {
    e.preventDefault();
    if (!f.checkValidity()) {
      const bad = f.querySelector<HTMLInputElement>(':invalid');
      show(err, bad?.name === 'privacy' ? 'Serve il consenso al trattamento dei dati per risponderti.' : bad?.type === 'email' ? 'Controlla l\'indirizzo email.' : 'Compila nome, email e messaggio.');
      bad?.focus(); return;
    }
    btn.disabled = true; btn.textContent = 'Invio…';
    try {
      const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
      const d = await r.json();
      if (d.ok) { show(ok, d.msg); f.hidden = true; }
      else show(err, d.msg);
    } catch {
      show(err, 'Invio non riuscito: controlla la connessione oppure scrivi a info@gesthallsuite.it.');
    }
    btn.disabled = false; btn.textContent = 'Invia la richiesta';
  });
</script>
