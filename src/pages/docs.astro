---
import Layout from '../layouts/Layout.astro';
import changelog from '../data/changelog.json';
import { ICONE } from '../data/aree';
const last = changelog.releases.find((r) => r.highlights.length) ?? changelog.releases[0];
const capitoli = [
  ['accesso', 'Primo accesso e ruoli'], ['cassa', 'Cassa giornaliera'], ['dashboard', 'Dashboard'], ['report', 'Report'],
  ['turni', 'Turni'], ['macchine', 'Macchine'], ['ticket', 'Ticket assistenza'], ['bar', 'Bar'],
  ['chat', 'Chat'], ['documenti', 'Documenti'], ['anagrafica', 'Clienti'], ['prestiti', 'Prestiti'],
  ['push', 'App e notifiche'], ['impostazioni', 'Impostazioni'], ['sicurezza', 'Sicurezza'], ['problemi', 'Problemi comuni'],
];
---
<Layout page="Risorse" description="Guida all'uso di GestHall Suite, novità delle versioni, area clienti e documentazione per installatori.">

<section class="page-hero">
  <div class="container">
    <nav class="crumbs" aria-label="Percorso"><a href="/">Home</a><span aria-hidden="true">/</span><span>Risorse</span></nav>
    <span class="eyebrow">Risorse</span>
    <h1>Guide, novità e accessi.</h1>
    <p class="lead">Tutto quello che serve a operatori, responsabili e installatori per usare e mantenere GestHall Suite.</p>
  </div>
</section>

<section class="section-tight" style="padding-top:0">
  <div class="container">
    <div class="split guide reveal">
      <div>
        <div class="icon" set:html={ICONE.doc}></div>
        <h2>Guida all'uso</h2>
        <p class="lead">Cassa, turni, report, bar, chat, impostazioni: ogni sezione spiegata passo per passo, per operatori, responsabili e revisori.</p>
        <a href="/docs/guida/" class="btn btn-primary">Apri la guida</a>
      </div>
      <ul class="chapters">
        {capitoli.map(([id, t]) => <li><a href={`/docs/guida/#${id}`}>{t}<span aria-hidden="true">→</span></a></li>)}
      </ul>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container">
    <div class="grid g3">
      <a href="/changelog" class="card res">
        <div class="icon" set:html={ICONE.aggiorna}></div>
        <h3>Novità</h3>
        <p>Versione {last.version}: {last.highlights.join(' · ')}.</p>
        <span class="link">Tutte le versioni <span aria-hidden="true">→</span></span>
      </a>
      <a href="/cliente/" class="card res">
        <div class="icon" set:html={ICONE.utenti}></div>
        <h3>Area clienti</h3>
        <p>Piano, scadenza e richieste di cambio piano. Ci entri dal link che genera l'app in Impostazioni → Piano e licenza.</p>
        <span class="link">Vai all'area clienti <span aria-hidden="true">→</span></span>
      </a>
      <a href="/sicurezza#dati" class="card res">
        <div class="icon" set:html={ICONE.server}></div>
        <h3>Requisiti e installazione</h3>
        <p>PHP 8.1+, MySQL o MariaDB, HTTPS. Installazione guidata su hosting condiviso, backup e aggiornamenti dall'app.</p>
        <span class="link">Requisiti tecnici <span aria-hidden="true">→</span></span>
      </a>
    </div>
    <div class="card reserved reveal">
      <div class="icon" set:html={ICONE.chiave}></div>
      <div>
        <h3>Area riservata</h3>
        <p>Documentazione tecnica, procedure di manutenzione e materiali per il team e i partner. Accesso con password.</p>
      </div>
      <a href="/interno" class="btn btn-ghost">Accedi</a>
    </div>
    <p class="muted small" style="margin-top:24px">Non trovi una risposta? <a class="ilink" href="/contatti?motivo=assistenza">Scrivici</a>: rispondiamo entro un giorno lavorativo.</p>
  </div>
</section>
</Layout>

<style>
.guide { background: var(--surface); border: 1px solid var(--border); border-radius: 24px; padding: clamp(24px, 4vw, 44px); grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) }
.guide h2 { font-size: clamp(26px, 3vw, 34px); margin: 0 0 12px }
.chapters { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px }
.chapters a { display: flex; justify-content: space-between; padding: 11px 2px; border-bottom: 1px solid var(--border); font-size: 15px; font-weight: 550 }
.chapters a span { color: var(--faint); transition: transform .15s }
.chapters a:hover { color: var(--accent-ink) }
.chapters a:hover span { transform: translateX(3px); color: var(--accent-ink) }
.res { display: flex; flex-direction: column }
.res p { flex: 1; margin-bottom: 16px }
.reserved { display: flex; align-items: center; gap: 18px; margin-top: 20px }
.reserved .icon { margin: 0 }
.reserved > div:nth-child(2) { flex: 1 }
@media (max-width: 640px) {
  .chapters { grid-template-columns: 1fr }
  .reserved { flex-wrap: wrap }
}
</style>
