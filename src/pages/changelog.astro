---
import Layout from '../layouts/Layout.astro';
import changelog from '../data/changelog.json';

const LABEL = { add: 'Novità', change: 'Migliorato', fix: 'Corretto' };
const fmt = (d) => new Date(d + 'T12:00:00').toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout page="Changelog" description="Tutte le novità di GestHall Suite: nuove funzionalità, miglioramenti e correzioni release per release.">

<section class="page-hero">
  <div class="container">
    <nav class="crumbs" aria-label="Percorso"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/docs">Risorse</a><span aria-hidden="true">/</span><span>Novità</span></nav>
    <span class="eyebrow">Novità</span>
    <h1>Cosa c'è di nuovo in GestHall Suite.</h1>
    <p class="lead">Ogni versione, dalla più recente: nuove funzioni, miglioramenti e correzioni che cambiano il lavoro di ogni giorno.</p>
  </div>
</section>

<section class="cl-body">
  <div class="container">
    <div class="cl-feed">
      {changelog.releases.map((r) => (
        <div class="cl-entry" id={'v' + r.version}>
          <div class="cl-entry-head">
            <a class="cl-ver" href={'#v' + r.version}>v{r.version}</a>
            <time class="cl-date" datetime={r.date}>{fmt(r.date)}</time>
            {r.hotfix && <span class="cl-hotfix">Hotfix</span>}
            {r.title && <span class="cl-title">{r.title}</span>}
          </div>
          <div class="cl-entry-body">
            {r.groups.map((g) => (
              <div class="cl-group">
                <span class={'cl-badge cl-badge-' + g.type}>{LABEL[g.type]}</span>
                <ul class="cl-list">
                  {g.items.map((it) => <li set:html={it} />)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="cl-footer">
      <a href="/docs" class="cl-back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 7H2M6 3l-4 4 4 4"/></svg>
        Torna alle risorse
      </a>
      <p class="cl-note">Le nuove versioni si installano dall'app, in Impostazioni → Sistema → Aggiornamenti. Serve aiuto? <a href="/contatti?motivo=assistenza">Scrivici</a>.</p>
    </div>

  </div>
</section>

</Layout>

<style>
.cl-body { padding: 0 0 clamp(60px, 8vw, 100px) }
.cl-feed { display: grid; gap: 16px; max-width: 860px }
.cl-entry { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-l); padding: clamp(20px, 3vw, 28px) }
.cl-entry-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 16px }
.cl-ver { font-size: 22px; font-weight: 750; letter-spacing: -.02em }
.cl-ver:hover { color: var(--accent-ink) }
.cl-date { font-size: 13.5px; color: var(--muted); padding: 3px 10px; border-radius: 99px; background: var(--surface-2); border: 1px solid var(--border) }
.cl-hotfix { font-size: 12px; font-weight: 700; padding: 3px 9px; border-radius: 99px; background: var(--amber-weak); color: var(--amber) }
.cl-title { font-weight: 650; color: var(--text) }
.cl-entry-body { display: grid; gap: 16px }
.cl-group { display: grid; gap: 10px }
.cl-badge { justify-self: start; font-size: 11.5px; font-weight: 750; text-transform: uppercase; letter-spacing: .06em; padding: 3px 10px; border-radius: 6px }
.cl-badge-add { background: var(--accent-weak); color: var(--accent-ink) }
.cl-badge-change { background: var(--surface-2); color: var(--text); border: 1px solid var(--border) }
.cl-badge-fix { background: var(--amber-weak); color: var(--amber) }
.cl-list { display: grid; gap: 8px }
.cl-list li { position: relative; padding-left: 18px; color: var(--muted); font-size: 15.5px }
.cl-list li::before { content: ''; position: absolute; left: 2px; top: 10px; width: 6px; height: 6px; border-radius: 50%; background: var(--border-strong) }
.cl-list li :global(strong) { color: var(--text) }
.cl-list li :global(code) { font-size: 13px }
.cl-footer { display: grid; gap: 12px; padding-top: 32px; max-width: 860px }
.cl-back { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--accent-ink) }
.cl-note { color: var(--muted); font-size: 15px }
.cl-note a { color: var(--accent-ink); font-weight: 600 }
</style>
