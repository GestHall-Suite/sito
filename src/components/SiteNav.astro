---
import Logo from './Logo.astro';
import { aree, ICONE } from '../data/aree';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const on = (p: string) => (path === p || path.startsWith(p + '/')) ? 'page' : undefined;
---
<header class="nav" id="nav">
  <div class="container nav-in">
    <a href="/" class="nav-logo" aria-label="GestHall Suite, pagina iniziale"><Logo /></a>

    <nav class="nav-links" aria-label="Principale">
      <div class="nav-dd">
        <button type="button" class="nav-a nav-dd-btn" aria-expanded="false" aria-controls="nav-prodotto" aria-current={on('/prodotto')}>
          Prodotto
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg>
        </button>
        <div class="nav-panel" id="nav-prodotto">
          <div class="nav-panel-grid">
            {aree.map(a => (
              <a href={`/prodotto/${a.slug}`} class="nav-item">
                <span class="nav-ic" set:html={a.icon}></span>
                <span><b>{a.nome}</b><small>{a.breve}</small></span>
              </a>
            ))}
            <a href="/sicurezza" class="nav-item">
              <span class="nav-ic" set:html={ICONE.scudo}></span>
              <span><b>Sicurezza e dati</b><small>Backup, accessi, aggiornamenti</small></span>
            </a>
          </div>
          <a href="/prodotto" class="nav-panel-foot">Panoramica del prodotto <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <a href="/prezzi" class="nav-a" aria-current={on('/prezzi')}>Prezzi</a>
      <a href="/sicurezza" class="nav-a nav-only-wide" aria-current={on('/sicurezza')}>Sicurezza</a>
      <a href="/rivenditori" class="nav-a" aria-current={on('/rivenditori')}>Rivenditori</a>
      <a href="/docs" class="nav-a" aria-current={on('/docs')}>Risorse</a>
    </nav>

    <div class="nav-right">
      <button type="button" class="nav-theme" id="theme-btn" aria-label="Cambia tema chiaro/scuro">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href="/contatti?motivo=demo" class="btn btn-primary nav-cta">Richiedi una demo</a>
      <button type="button" class="nav-burger" id="nav-burger" aria-label="Apri il menu" aria-expanded="false" aria-controls="nav-sheet">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav-sheet" id="nav-sheet" hidden>
    <div class="container">
      <p class="nav-sheet-h">Prodotto</p>
      <a href="/prodotto" class="nav-sheet-a">Panoramica</a>
      {aree.map(a => <a href={`/prodotto/${a.slug}`} class="nav-sheet-a">{a.nome}</a>)}
      <p class="nav-sheet-h">GestHall Suite</p>
      <a href="/prezzi" class="nav-sheet-a">Prezzi</a>
      <a href="/sicurezza" class="nav-sheet-a">Sicurezza e dati</a>
      <a href="/rivenditori" class="nav-sheet-a">Rivenditori</a>
      <a href="/docs" class="nav-sheet-a">Risorse e guida</a>
      <a href="/changelog" class="nav-sheet-a">Novità</a>
      <a href="/contatti" class="nav-sheet-a">Contatti</a>
      <a href="/contatti?motivo=demo" class="btn btn-primary btn-block btn-lg nav-sheet-cta">Richiedi una demo</a>
    </div>
  </div>
</header>

<style>
.nav { position: sticky; top: 0; z-index: 100; background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); border-bottom: 1px solid transparent; transition: border-color .2s }
.nav.scrolled { border-bottom-color: var(--border) }
.nav-in { display: flex; align-items: center; gap: 28px; height: 68px }
.nav-logo { flex: none }
.nav-links { display: flex; align-items: center; gap: 4px; flex: 1 }
.nav-a { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 12px; border-radius: 10px; font-size: 15px; font-weight: 550; color: var(--muted); transition: color .15s, background .15s }
.nav-a:hover, .nav-a[aria-expanded="true"] { color: var(--text); background: var(--surface-2) }
.nav-a[aria-current="page"] { color: var(--text) }
.nav-dd { position: relative }
.nav-dd-btn svg { transition: transform .2s }
.nav-dd-btn[aria-expanded="true"] svg { transform: rotate(180deg) }
.nav-panel { position: absolute; top: calc(100% + 10px); left: -12px; width: 620px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-l); box-shadow: var(--sh-3); padding: 10px; opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .18s, transform .18s var(--ease), visibility .18s }
.nav-panel.open { opacity: 1; visibility: visible; transform: none }
.nav-panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px }
.nav-item { display: flex; gap: 12px; padding: 12px; border-radius: 12px; transition: background .15s }
.nav-item:hover { background: var(--surface-2) }
.nav-item b { display: block; font-size: 15px; font-weight: 650; margin-bottom: 2px }
.nav-item small { display: block; font-size: 13.5px; color: var(--muted); line-height: 1.4 }
.nav-ic { width: 36px; height: 36px; flex: none; border-radius: 10px; display: grid; place-items: center; background: var(--accent-weak); color: var(--accent-ink) }
.nav-ic :global(svg) { width: 19px; height: 19px; margin: 0 }
.nav-panel-foot { display: flex; justify-content: space-between; margin-top: 6px; padding: 12px 14px; border-top: 1px solid var(--border); font-size: 14px; font-weight: 600; color: var(--accent-ink) }
.nav-right { display: flex; align-items: center; gap: 10px; margin-left: auto }
.nav-theme { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; color: var(--muted); border: 1px solid var(--border) }
.nav-theme:hover { color: var(--text); border-color: var(--border-strong) }
.nav-theme svg { width: 18px; height: 18px }
.i-sun { display: none }
:global([data-theme="dark"]) .i-sun { display: block }
:global([data-theme="dark"]) .i-moon { display: none }
.nav-cta { min-height: 40px; padding: 0 16px; font-size: 14.5px }
.nav-burger { display: none; width: 42px; height: 42px; border-radius: 10px; border: 1px solid var(--border); position: relative }
.nav-burger span { position: absolute; left: 12px; right: 12px; height: 2px; border-radius: 2px; background: var(--text); transition: transform .2s, top .2s }
.nav-burger span:first-child { top: 16px }
.nav-burger span:last-child { top: 23px }
.nav-burger[aria-expanded="true"] span:first-child { top: 19.5px; transform: rotate(45deg) }
.nav-burger[aria-expanded="true"] span:last-child { top: 19.5px; transform: rotate(-45deg) }
.nav-sheet { position: fixed; inset: 68px 0 0; background: var(--bg); overflow-y: auto; padding: 8px 0 32px; border-top: 1px solid var(--border) }
.nav-sheet-h { font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); margin: 20px 0 6px }
.nav-sheet-a { display: block; padding: 12px 0; font-size: 18px; font-weight: 600; border-bottom: 1px solid var(--border) }
.nav-sheet-cta { margin-top: 28px }

@media (max-width: 1080px) { .nav-only-wide { display: none } }
@media (max-width: 900px) {
  .nav-links, .nav-cta { display: none }
  .nav-burger { display: block }
  .nav-in { height: 64px }
  .nav-sheet { inset: 64px 0 0 }
}
</style>

<script>
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

  const btn = nav.querySelector<HTMLButtonElement>('.nav-dd-btn')!;
  const panel = document.getElementById('nav-prodotto')!;
  const dd = btn.parentElement!;
  let t: number | undefined;
  const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); panel.classList.toggle('open', open); };
  btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  if (matchMedia('(hover: hover)').matches) {
    dd.addEventListener('mouseenter', () => { clearTimeout(t); set(true); });
    dd.addEventListener('mouseleave', () => { t = window.setTimeout(() => set(false), 160); });
  }
  document.addEventListener('click', e => { if (!dd.contains(e.target as Node)) set(false); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { set(false); closeSheet(); } });

  const burger = document.getElementById('nav-burger')!;
  const sheet = document.getElementById('nav-sheet')!;
  const closeSheet = () => { sheet.hidden = true; burger.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; };
  burger.addEventListener('click', () => {
    const open = sheet.hidden;
    sheet.hidden = !open; burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
  matchMedia('(min-width: 901px)').addEventListener('change', e => { if (e.matches) closeSheet(); });

  document.getElementById('theme-btn')!.addEventListener('click', () => {
    const dark = document.documentElement.dataset.theme !== 'dark';
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    try { localStorage.setItem('gh-site-theme', dark ? 'dark' : 'light'); } catch (e) {}
  });
</script>
