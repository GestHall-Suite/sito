---
import Logo from './Logo.astro';
import { aree } from '../data/aree';
const anno = new Date().getFullYear();
---
<footer class="foot">
  <div class="container foot-in">
    <div class="foot-brand">
      <a href="/" aria-label="GestHall Suite"><Logo size={28} /></a>
      <p>Il gestionale della cassa e della sala per le sale giochi italiane con VLT e AWP.</p>
      <a href="mailto:info@gesthallsuite.it" class="foot-mail">info@gesthallsuite.it</a>
    </div>
    <nav class="foot-cols" aria-label="Piè di pagina">
      <div>
        <p>Prodotto</p>
        <a href="/prodotto">Panoramica</a>
        {aree.map(a => <a href={`/prodotto/${a.slug}`}>{a.nome}</a>)}
      </div>
      <div>
        <p>Azienda</p>
        <a href="/prezzi">Prezzi</a>
        <a href="/sicurezza">Sicurezza e dati</a>
        <a href="/rivenditori">Rivenditori</a>
        <a href="/contatti">Contatti</a>
      </div>
      <div>
        <p>Risorse</p>
        <a href="/docs">Documentazione</a>
        <a href="/docs/guida/">Guida all'uso</a>
        <a href="/changelog">Novità</a>
        <a href="/cliente/">Area clienti</a>
      </div>
      <div>
        <p>Legale</p>
        <a href="/privacy">Privacy</a>
        <a href="/termini">Termini di servizio</a>
      </div>
    </nav>
  </div>
  <div class="container foot-bottom">
    <span>© {anno} GestHall Suite</span>
    <span>Software per sale giochi · Made in Italy</span>
  </div>
</footer>

<style>
.foot { background: var(--ink); color: var(--ink-muted); padding: 64px 0 0; margin-top: auto }
.foot-in { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 56px; padding-bottom: 48px }
.foot-brand { color: #fff; max-width: 340px }
.foot-brand p { color: var(--ink-muted); font-size: 15px; margin: 16px 0 14px }
.foot-mail { color: #4fe0b7; font-weight: 600; font-size: 15px }
.foot-cols { display: grid; grid-template-columns: repeat(4, auto); gap: 48px }
.foot-cols div { display: flex; flex-direction: column; gap: 10px }
.foot-cols p { font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #fff; margin-bottom: 4px }
.foot-cols a { font-size: 14.5px; transition: color .15s }
.foot-cols a:hover, .foot-mail:hover { color: #fff }
.foot-bottom { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 22px 24px; border-top: 1px solid rgba(255, 255, 255, .08); font-size: 13.5px }
@media (max-width: 980px) { .foot-in { grid-template-columns: 1fr } }
@media (max-width: 640px) {
  .foot-cols { grid-template-columns: 1fr 1fr; gap: 32px 24px }
  .foot-bottom { padding: 20px 16px }
}
</style>
